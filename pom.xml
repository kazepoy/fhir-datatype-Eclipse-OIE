<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.matthy.oie</groupId>
  <artifactId>datatype-fhir</artifactId>
  <version>1.6.0-poc</version>
  <packaging>jar</packaging>

  <name>OIE FHIR Data Type</name>
  <description>
    HL7 FHIR data type for Eclipse Open Integration Engine: FHIR JSON and XML in, FHIR XML in the
    transformer, JSON or XML out, with validation against the base specification and your own profiles.
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Must match the engine you deploy to. -->
    <oie.version>4.7.0</oie.version>
    <hapi.version>8.12.1</hapi.version>
    <!-- The engine's Log4j (server-lib/log4j). -->
    <log4j.version>2.25.3</log4j.version>
  </properties>

  <dependencies>
    <!--
      HAPI FHIR and its dependencies are copied into lib/ and loaded in the plugin's own class loader
      (see FhirEngineLoader), so they can never clash with the libraries on the engine's classpath.
    -->
    <dependency>
      <groupId>ca.uhn.hapi.fhir</groupId>
      <artifactId>hapi-fhir-base</artifactId>
      <version>${hapi.version}</version>
    </dependency>
    <dependency>
      <groupId>ca.uhn.hapi.fhir</groupId>
      <artifactId>hapi-fhir-structures-r4</artifactId>
      <version>${hapi.version}</version>
      <!-- OkHttp (with Okio and Kotlin) is only used to download packages and terminology from the internet. -->
      <exclusions>
        <exclusion><groupId>net.sf.saxon</groupId><artifactId>Saxon-HE</artifactId></exclusion>
        <exclusion><groupId>com.squareup.okhttp3</groupId><artifactId>*</artifactId></exclusion>
        <exclusion><groupId>com.squareup.okio</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>ca.uhn.hapi.fhir</groupId>
      <artifactId>hapi-fhir-validation</artifactId>
      <version>${hapi.version}</version>
      <!--
        Not needed to validate R4, R4B or R5: DSTU2 versions, diagram rendering, git,
        a converter cache in SQLite, XSLT (Saxon), Thymeleaf's expression language (OGNL), XML
        signatures, Markdown rendering and an HTTP client. Put one back if a validation path turns out
        to need it.
        Tried and needed: dstu3 and the convertors (profiles are converted internally), Thymeleaf,
        ICU4J (message formatting) and nimbus-jose-jwt (Bundle validation).
      -->
      <exclusions>
        <exclusion><groupId>ca.uhn.hapi.fhir</groupId><artifactId>org.hl7.fhir.dstu2</artifactId></exclusion>
        <exclusion><groupId>ca.uhn.hapi.fhir</groupId><artifactId>org.hl7.fhir.dstu2016may</artifactId></exclusion>
        <exclusion><groupId>net.sourceforge.plantuml</groupId><artifactId>plantuml-mit</artifactId></exclusion>
        <exclusion><groupId>org.eclipse.jgit</groupId><artifactId>org.eclipse.jgit</artifactId></exclusion>
        <exclusion><groupId>org.xerial</groupId><artifactId>sqlite-jdbc</artifactId></exclusion>
        <exclusion><groupId>net.sf.saxon</groupId><artifactId>Saxon-HE</artifactId></exclusion>
        <exclusion><groupId>ognl</groupId><artifactId>ognl</artifactId></exclusion>
        <exclusion><groupId>org.apache.santuario</groupId><artifactId>xmlsec</artifactId></exclusion>
        <exclusion><groupId>org.commonmark</groupId><artifactId>*</artifactId></exclusion>
        <exclusion><groupId>org.apache.httpcomponents</groupId><artifactId>httpclient</artifactId></exclusion>
      </exclusions>
    </dependency>
    <!-- The FHIR client and its Apache HTTP client, for the terminology server option (RemoteTerminologyServiceValidationSupport). -->
    <dependency>
      <groupId>ca.uhn.hapi.fhir</groupId>
      <artifactId>hapi-fhir-client</artifactId>
      <version>${hapi.version}</version>
    </dependency>
    <!-- One structures and one validation-resources library per FHIR Version (FhirSerializationProperties.FhirVersion). -->
    <dependency>
      <groupId>ca.uhn.hapi.fhir</groupId>
      <artifactId>hapi-fhir-validation-resources-r4</artifactId>
      <version>${hapi.version}</version>
    </dependency>
    <dependency>
      <groupId>ca.uhn.hapi.fhir</groupId>
      <artifactId>hapi-fhir-structures-r4b</artifactId>
      <version>${hapi.version}</version>
    </dependency>
    <dependency>
      <groupId>ca.uhn.hapi.fhir</groupId>
      <artifactId>hapi-fhir-validation-resources-r4b</artifactId>
      <version>${hapi.version}</version>
    </dependency>
    <dependency>
      <groupId>ca.uhn.hapi.fhir</groupId>
      <artifactId>hapi-fhir-structures-r5</artifactId>
      <version>${hapi.version}</version>
      <!-- Brings back what is excluded from hapi-fhir-validation above. -->
      <exclusions>
        <exclusion><groupId>net.sourceforge.plantuml</groupId><artifactId>plantuml-mit</artifactId></exclusion>
        <exclusion><groupId>org.eclipse.jgit</groupId><artifactId>org.eclipse.jgit</artifactId></exclusion>
        <exclusion><groupId>org.xerial</groupId><artifactId>sqlite-jdbc</artifactId></exclusion>
        <exclusion><groupId>net.sf.saxon</groupId><artifactId>Saxon-HE</artifactId></exclusion>
        <exclusion><groupId>com.squareup.okhttp3</groupId><artifactId>*</artifactId></exclusion>
        <exclusion><groupId>com.squareup.okio</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>ca.uhn.hapi.fhir</groupId>
      <artifactId>hapi-fhir-validation-resources-r5</artifactId>
      <version>${hapi.version}</version>
    </dependency>
    <dependency>
      <groupId>ca.uhn.hapi.fhir</groupId>
      <artifactId>hapi-fhir-caching-caffeine</artifactId>
      <version>${hapi.version}</version>
    </dependency>
    <!--
      HAPI logs through SLF4J. This provider sends it to the engine's own Log4j (log4j-api and
      log4j-core come from the engine: see PARENT_FIRST in FhirEngineLoader), so HAPI's warnings and
      errors end up in the server log. Keep the version equal to the engine's Log4j.
    -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-slf4j2-impl</artifactId>
      <version>${log4j.version}</version>
      <exclusions>
        <exclusion><groupId>org.apache.logging.log4j</groupId><artifactId>log4j-api</artifactId></exclusion>
        <exclusion><groupId>org.apache.logging.log4j</groupId><artifactId>log4j-core</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.woodstox</groupId>
      <artifactId>woodstox-core</artifactId>
      <version>6.7.0</version>
    </dependency>

    <!-- Engine jars, from the local repository. -->
    <dependency>
      <groupId>com.mirth.connect</groupId>
      <artifactId>server-api</artifactId>
      <version>${oie.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.mirth.connect</groupId>
      <artifactId>donkey-server</artifactId>
      <version>${oie.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.mirth.connect</groupId>
      <artifactId>donkey-model</artifactId>
      <version>${oie.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.mirth.connect</groupId>
      <artifactId>client</artifactId>
      <version>${oie.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.mirth.connect</groupId>
      <artifactId>client-core</artifactId>
      <version>${oie.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Already on the engine's classpath. -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-api</artifactId>
      <version>${log4j.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- The engine's version (server-lib/commons): HAPI's terminology client needs 3.18 or later. -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
      <version>3.20.0</version>
      <scope>provided</scope>
    </dependency>

    <!-- REST API of the FHIR Profile Mapper (server-lib versions). -->
    <dependency>
      <groupId>javax.ws.rs</groupId>
      <artifactId>javax.ws.rs-api</artifactId>
      <version>2.0.1</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>javax.servlet</groupId>
      <artifactId>javax.servlet-api</artifactId>
      <version>3.1.0</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.mozilla</groupId>
      <artifactId>rhino</artifactId>
      <version>1.7.13</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
    <!-- The engine's ObjectXMLSerializer, to generate examples/fhir-functions-code-templates.xml (server-lib versions). -->
    <dependency>
      <groupId>com.thoughtworks.xstream</groupId>
      <artifactId>xstream</artifactId>
      <version>1.4.20</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>xpp3</groupId>
      <artifactId>xpp3</artifactId>
      <version>1.1.4c</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.artifactId}-${project.version}</finalName>
    <plugins>
      <!--
        The plugin jars (shared, server, client) target Java 11 like the engine's own plugins, so the
        Administrator keeps working on any supported Java. The FHIR engine needs Java 17 (HAPI FHIR 8),
        which is what the engine ships with.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <executions>
          <execution>
            <id>default-compile</id>
            <configuration>
              <release>11</release>
              <excludes><exclude>com/mirth/connect/plugins/datatypes/fhir/engine/**</exclude></excludes>
            </configuration>
          </execution>
          <execution>
            <id>engine-compile</id>
            <phase>compile</phase>
            <goals><goal>compile</goal></goals>
            <configuration>
              <release>17</release>
              <includes><include>com/mirth/connect/plugins/datatypes/fhir/engine/**</include></includes>
            </configuration>
          </execution>
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <release>17</release>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>

      <!-- The engine wants three jars: shared (serializer + properties), server and client. The FHIR engine jar goes to lib/. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <executions>
          <execution>
            <id>default-jar</id>
            <phase>none</phase>
          </execution>
          <execution>
            <id>shared-jar</id>
            <phase>package</phase>
            <goals><goal>jar</goal></goals>
            <configuration>
              <classifier>shared</classifier>
              <includes><include>com/mirth/connect/plugins/datatypes/fhir/*.class</include><include>com/mirth/connect/plugins/datatypes/fhir/*.js</include></includes>
            </configuration>
          </execution>
          <execution>
            <id>server-jar</id>
            <phase>package</phase>
            <goals><goal>jar</goal></goals>
            <configuration>
              <classifier>server</classifier>
              <includes><include>com/mirth/connect/plugins/datatypes/fhir/server/**</include></includes>
            </configuration>
          </execution>
          <execution>
            <id>client-jar</id>
            <phase>package</phase>
            <goals><goal>jar</goal></goals>
            <configuration>
              <classifier>client</classifier>
              <includes><include>com/mirth/connect/plugins/datatypes/fhir/client/**</include></includes>
            </configuration>
          </execution>
          <execution>
            <id>engine-jar</id>
            <phase>package</phase>
            <goals><goal>jar</goal></goals>
            <configuration>
              <classifier>engine</classifier>
              <includes><include>com/mirth/connect/plugins/datatypes/fhir/engine/**</include></includes>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- HAPI FHIR and its dependencies go unmodified into lib/. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.7.0</version>
        <executions>
          <execution>
            <id>engine-libs</id>
            <phase>package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <includeScope>runtime</includeScope>
              <outputDirectory>${project.build.directory}/lib</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.7.1</version>
        <configuration>
          <descriptors>
            <descriptor>assembly.xml</descriptor>
          </descriptors>
          <appendAssemblyId>false</appendAssemblyId>
        </configuration>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>single</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
