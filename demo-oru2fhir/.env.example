# Réglages de la démo. Copier en .env pour les changer ; sans .env, compose.yaml prend ces
# valeurs par défaut, qui conviennent à un poste de développement (pas à une production).

# Adresse d'écoute sur l'hôte, et ports publiés : administration web / API, et le canal ORU.
OIE_BIND_ADDRESS=127.0.0.1
OIE_HTTPS_PORT=8443
ORU_PORT=8081

TZ=Europe/Paris

# Mémoire Java maximale (-Xmx) : la validation FHIR charge la spécification R4 (environ 130 Mo).
OIE_JAVA_MAX_HEAP=2g

# Compte admin : appliqué à la création de la base seulement (15 caractères minimum).
OIE_PASSWORD=demo-oru2fhir-admin

# Base et keystore : à fixer avant le premier démarrage, ne plus les changer ensuite.
POSTGRES_PASSWORD=demo-oru2fhir-db
OIE_KEYSTORE_STOREPASS=demo-oru2fhir-store
OIE_KEYSTORE_KEYPASS=demo-oru2fhir-key
OIE_SERVER_ID=6a3c1f0e-0d6b-4c55-9a1e-2f7d8b9c0a11

# true : réimporte le canal d'oie-init/channels/ même s'il existe déjà dans le moteur.
OIE_INIT_FORCE=false

# true : l'administration n'ouvre pas l'assistant de première connexion, qui demande de changer
# le mot de passe. false pour le garder (à faire hors démo).
OIE_SKIP_FIRST_LOGIN=true

# Options du build Gradle de l'image officielle ; -x test raccourcit le premier build.
OIE_GRADLE_BUILD_ARGS=-PdisableSigning=true
